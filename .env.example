# Copia a .env.local. Los valores de Neon los llena `neon env pull`.

# --- Neon (automático: neon link && neon deploy) ---
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# --- App ---
# Contrasena compartida para entrar a la PWA.
APP_PASSWORD=

# --- Extraccion ---
# mock = datos simulados, sin credencial ni costo
# openai = modelo de vision real
EXTRACCION_PROVIDER=mock
EXTRACCION_MODELO=
OPENAI_API_KEY=
# Solo si se usa el AI Gateway de Neon u otro proxy compatible con OpenAI.
OPENAI_BASE_URL=
